generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  notifiedAt DateTime @default(now())
  fromUserId String   @db.Uuid
  isRead     Boolean  @default(false)
  postId     String?  @db.Uuid
  toUserId   String   @db.Uuid
  type       String
  user1      User     @relation("sendBy", fields: [fromUserId], references: [id])
  post       Post?    @relation(fields: [postId], references: [id])
  user2      User     @relation("receiveBy", fields: [toUserId], references: [id])
}

model FriendRequest {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @db.Uuid
  receiverId  String    @db.Uuid
  isAccepted  Boolean?
  requestedAt DateTime  @default(now())
  acceptedAt  DateTime? @updatedAt
  type        Request
  receiver    User      @relation("ReceiverRequests", fields: [receiverId], references: [id])
  sender      User      @relation("SenderRequests", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model Friendship {
  id         String   @id @default(uuid()) @db.Uuid
  follower   String   @db.Uuid
  following  String   @db.Uuid
  createdAt  DateTime @default(now())
  followers  User     @relation("Friendship_followerToUser", fields: [follower], references: [id], map: "Friendship_user1Id_fkey")
  followings User     @relation("Friendship_followingToUser", fields: [following], references: [id], map: "Friendship_user2Id_fkey")

  @@unique([follower, following], map: "Friendship_user1Id_user2Id_key")
}

model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  commentId String   @db.Uuid
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId, commentId])
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  is_liked  Boolean? @default(true)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Comment {
  id          String        @id @default(uuid()) @db.Uuid
  comment     String
  authorId    String?       @db.Uuid
  postId      String?       @db.Uuid
  createdAt   DateTime      @default(now())
  likeCount   Int           @default(0)
  author      User?         @relation(fields: [authorId], references: [id])
  Post        Post?         @relation(fields: [postId], references: [id])
  CommentLike CommentLike[]
}

model Post {
  id           String         @id @default(uuid()) @db.Uuid
  title        String         @unique
  content      String
  authorId     String         @db.Uuid
  createdAt    DateTime       @default(now())
  likeCount    Int            @default(0)
  category     Category       @default(UNDEFINED)
  is_revoked   Boolean?       @default(false)
  Comment      Comment[]
  CommentLike  CommentLike[]
  Notification Notification[]
  author       User           @relation(fields: [authorId], references: [id])
  postLikes    PostLike[]
  postImages   PostImages[]
}

model PostImages {
  id       String   @id @default(uuid()) @db.Uuid
  postId   String   @db.Uuid
  imageId  String   @db.Uuid
  postedAt DateTime @default(now()) @db.Timestamp(3)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  image    Images   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([postId, imageId])
}

model Images {
  id         String   @id @default(uuid()) @db.Uuid
  url        String
  userId     String   @db.Uuid
  uploadedAt DateTime @default(now()) @db.Timestamp(3)

  // Existing 1-to-many relation (all images uploaded by this user)
  user User @relation("UserUploadedImages", fields: [userId], references: [id], onDelete: Cascade)

  // New 1-to-1 back-relation (if this image is used as a profile picture)
  profileFor User? @relation("UserProfileImage")

  postImages PostImages[]
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(100)
  email            String       @unique @db.VarChar(100)
  password         String?      @db.VarChar(255)
  createdAt        DateTime     @default(now())
  role             Role         @default(USER)
  status           user_status? @default(offline)
  is_activated     Boolean?     @default(true)
  auth_method      String?      @default("email") @db.VarChar(50)
  auth_method_id   String?      @unique @db.VarChar(255)
  bio              String?
  codeExpiry       DateTime?    @db.Timestamptz(3)
  verificationCode String?      @db.Char(6)
  profileImageId   String?      @unique @db.Uuid
  profileImage     Images?      @relation("UserProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  // Existing 1-to-many relation (must match the relation name in Images)
  images                                Images[]        @relation("UserUploadedImages")
  Comment                               Comment[]
  CommentLike                           CommentLike[]
  FriendRequestReceived                 FriendRequest[] @relation("ReceiverRequests")
  FriendRequestSent                     FriendRequest[] @relation("SenderRequests")
  Friendship_Friendship_followerToUser  Friendship[]    @relation("Friendship_followerToUser")
  Friendship_Friendship_followingToUser Friendship[]    @relation("Friendship_followingToUser")
  Message                               Message[]       @relation("UserMessages")
  Notification1                         Notification[]  @relation("sendBy")
  Notification2                         Notification[]  @relation("receiveBy")
  Participant                           Participant[]
  posts                                 Post[]
  postLikes                             PostLike[]
}

model ChatRoom {
  id            String        @id @default(uuid()) @db.Uuid
  name          String?
  isGroup       Boolean       @default(false)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  directKey     String?       @unique
  lastMessageAt DateTime?     @db.Timestamptz(3)
  messages      Message[]
  participants  Participant[]

  @@index([lastMessageAt(sort: Desc)])
}

model Participant {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  chatRoomId    String            @db.Uuid
  role          participant_role? @default(member)
  joinedAt      DateTime          @default(now()) @db.Timestamptz(3)
  lastReadAt    DateTime?         @db.Timestamptz(3)
  lastReadMsgId String?           @db.Uuid
  leftAt        DateTime?         @db.Timestamptz(3)
  chatRoom      ChatRoom          @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatRoomId])
  @@index([chatRoomId])
}

model Message {
  id         String    @id @default(uuid()) @db.Uuid
  content    String
  senderId   String    @db.Uuid
  chatRoomId String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  editedAt   DateTime? @db.Timestamptz(3)
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User      @relation("UserMessages", fields: [senderId], references: [id])

  @@index([chatRoomId, createdAt(sort: Desc), id(sort: Desc)])
}

enum Role {
  USER
  ADMIN
}

enum Request {
  FRIEND_REQUEST_ACCEPTED
  FRIEND_REQUEST_SENT
  FRIEND_REQUEST_REJECTED
  FRIEND_REQUEST_REVOKED
}

enum Category {
  UNDEFINED
  PROGRAMMING
  GAMES
  ANIME
  MOVIES
}

enum Msg {
  USER_REQUEST
  USER_REQUEST_ACCEPTED
  LIKE_POST
  CREATE_POST
  COMMENT_POST
}

enum user_status {
  online
  offline
}

enum participant_role {
  member
  creator
  admin
}
